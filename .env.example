# Config for docker-compose.yml. Copy to .env (git-ignored) and fill in.

# Postgres, initialised with these on its first start (changing them later doesn't alter an
# existing database). Locally they match DATABASE_URL in back/.env, for `npm run dev`.
POSTGRES_USER=solaredev
POSTGRES_DB=solaredev
# In prod, a strong URL-safe value (it ends up in DATABASE_URL): `openssl rand -hex 32`
POSTGRES_PASSWORD=solaredev

# Ports published on 127.0.0.1 only: the site (http://localhost:8080) and Postgres.
FRONT_PORT=8080
POSTGRES_PORT=5432

# GitHub stats: fine-grained token, read-only (Metadata + Contents on all repositories).
# Private repos only count if "Private contributions" is enabled on the profile.
GITHUB_TOKEN=
GITHUB_USERNAME=SolareFlame
# Stats older than this are refreshed in the background (the old value is served meanwhile)
STATS_TTL_HOURS=6
